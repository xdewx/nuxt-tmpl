# === Database Configuration ===
# Prisma 要求 schema.prisma 中 provider 必须写死（不支持 env()）。
# 切换数据库时需同时修改 schema.prisma 和此变量：
#   sqlite:       DATABASE_PROVIDER=sqlite        DATABASE_URL=file:./data/dev.db
#   postgresql:   DATABASE_PROVIDER=postgresql    DATABASE_URL=postgresql://user:pass@host:5432/db
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/dev.db

# === Base Configuration ===
BASE_URL=http://localhost:3000

# === Auth Provider ===
# Options: clerk | better-auth | supabase | (empty = disabled)
# NUXT_PUBLIC_AUTH_PROVIDER=

# === Clerk Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=clerk
# NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NUXT_CLERK_SECRET_KEY=

# === Better-Auth Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=better-auth
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# === Supabase Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=supabase
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
